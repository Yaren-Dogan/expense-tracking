# Copy to .env (never committed) and fill in.

# Default: Google Gemini free tier. Create a key at https://aistudio.google.com/apikey
AI_API_KEY=

# Optional overrides. Default chat model is gemini-3.5-flash-lite: gemini-flash-latest is often overloaded (503)
# on the free tier. Model names: https://ai.google.dev/gemini-api/docs/models
# CHAT_MODEL=gemini-3.5-flash-lite
# EMBEDDING_MODEL=gemini-embedding-001

# Local models instead (downloads ~7 GB; start with: docker compose --profile ollama up -d)
# AI_PROVIDER=Ollama
# AI_ENDPOINT=http://ollama:11434
# CHAT_MODEL=qwen2.5:3b
# EMBEDDING_MODEL=bge-m3
